# --- API (cmd/api) -----------------------------------------------------------
# Supabase: Project Settings > Database > Connection string.
# Direct or session pooler (port 5432) works as-is. For the transaction pooler
# (port 6543) append: &default_query_exec_mode=simple_protocol
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Generate with: openssl rand -hex 32
JWT_SECRET=
# How long a scanner stays signed in. Must cover a full event day offline.
JWT_TTL=14h

PORT=8080
PUBLIC_DIR=./public

# Browser key: restrict to your domain (HTTP referrers) and the Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
# Optional. Enables Advanced Markers; without it the classic marker is used.
GOOGLE_MAPS_MAP_ID=

# Only if the frontend is served from a different origin than the API.
ALLOWED_ORIGIN=

# Scenario code the dashboard counts as "checked in" (default CHECK_IN).
CHECKIN_SCENARIO_CODE=CHECK_IN

# --- QR pass signing (API and scripts/seed) ------------------------------------
# Generate once with: openssl rand -hex 32. Both the API (adding delegates
# from /admin/ingest.html) and the seed script sign passes with it, so they
# must share the value. Keep it stable: changing it invalidates every QR pass
# already sent. Empty turns off adding delegates from the dashboard.
HMAC_SECRET_KEY=

# --- Staff credential emails -------------------------------------------------
# Public URL of this site; used for the sign-in link in emails.
APP_BASE_URL=https://pass.example.org
EVENT_NAME=NASA Space Apps Colombo
# Any SMTP relay (Google Workspace, Amazon SES, Resend, Mailgun, Postmark...).
# Leave SMTP_HOST empty to disable staff provisioning from the dashboard.
SMTP_HOST=
SMTP_PORT=587
# starttls (587, default) | tls (465) | none (local test servers only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=NASA Space Apps Colombo <no-reply@example.org>
# Pass email queue (/admin/emails.html): one email per interval, at most
# EMAIL_DAILY_LIMIT per rolling 24 hours (0 = no cap). Gmail allows ~500/day.
EMAIL_SEND_INTERVAL=2s
EMAIL_DAILY_LIMIT=450

# --- Behind a load balancer ---------------------------------------------------
# Header the platform sets to the real client IP (App Platform: DO-Connecting-IP).
# Leave empty when clients connect directly.
CLIENT_IP_HEADER=
# Per client IP per minute. Venue Wi-Fi shares one IP across every phone.
LOGIN_RATE_PER_MIN=30
PASS_RATE_PER_MIN=120

# Database connections the API may open; keep below the Supabase pool size.
DB_MAX_CONNS=10
